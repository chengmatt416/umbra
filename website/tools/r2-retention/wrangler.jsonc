{
  "name": "umbra-r2-retention",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-25",
  "workers_dev": false,
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "umbra-releases" }],
  "triggers": { "crons": ["17 4 * * *"] },
  "vars": { "DRY_RUN": "false" },
  "observability": { "enabled": true }
}
