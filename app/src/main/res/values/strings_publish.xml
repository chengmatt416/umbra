    <string name="pub_connect_title">Publish with Cloudflare Pages</string>
    <string name="pub_connect_body">Your page goes to your own Cloudflare account and is served free on pages.dev. Umbra needs your account ID and an API token that may edit Pages. You do this once.</string>
    <string name="pub_connect_step1">In Cloudflare, open My Profile → API Tokens and create a custom token.</string>
    <string name="pub_connect_open_tokens">Open API Tokens</string>
    <string name="pub_connect_step2">Give it one permission: Account · Cloudflare Pages · Edit. Create it and copy the token.</string>
    <string name="pub_connect_step3">Copy your Account ID: it is on the account’s home page under Account details, 32 letters and digits.</string>
