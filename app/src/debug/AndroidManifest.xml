<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Development entry point: lets adb switch the tool bridge on and off. Debug builds only. Guarded by DUMP, which
             the adb shell holds and ordinary apps cannot, so another app on the device cannot turn the bridge on. -->
        <receiver
            android:name=".DevControlReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="app.umbra.agent.dev.BRIDGE_START" />
                <action android:name="app.umbra.agent.dev.BRIDGE_STOP" />
                <action android:name="app.umbra.agent.dev.RESOLVE_APPROVAL" />
                <action android:name="app.umbra.agent.dev.HELPER_CONFIGURE" />
                <action android:name="app.umbra.agent.dev.ROOT_HELPER_CONFIGURE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
